# Unity build side-products - large, and Unity itself says not to ship them
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/

# Keep only the most recent APK in the repo
/Builds/CardboardBuild1.apk
/Builds/CardboardBuild2.apk
